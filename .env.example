# Notification backend: "telegram" (default) or "discord"
NOTIFIER=telegram

# Telegram (required if NOTIFIER=telegram)
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=123456789

# Discord (required if NOTIFIER=discord)
DISCORD_WEBHOOK_URL=

# AI / LLM (optional — omit AI_API_KEY to disable AI reports)
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Database
DB_PATH=metrics.sql

# Speedtest cycle interval in seconds or duration format (default: 3600 or 1h)
SPEEDTEST_INTERVAL=3600

# HTTP request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
